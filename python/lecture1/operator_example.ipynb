    "   \"id\": \"bc1374bdc4abbd2d\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"bool_greater_equal = (x >= z) # 10 大于等于 10，结果为 True\",\n",
    "   \"id\": \"ae3b6796985baab\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
