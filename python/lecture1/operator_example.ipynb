    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"bool_less_equal = (y <= x)  # 20 小于等于 10，结果为 False\",\n",
    "   \"id\": \"3ad4b3118b9429a0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## 比较运算符的错误示例\",\n",
    "   \"id\": \"b2f9f84132dc5f66\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"print(10 < 'hello') # 错误：TypeError: '<' not supported between instances of 'int' and 'str' (不同类型通常无法直接比较)\",\n",
    "   \"id\": \"4d82ad4f0eae2d20\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# 3. 逻辑运算符\",\n",
    "   \"id\": \"dade915f50b63cba\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"p = True\\n\",\n",
    "    \"q = False\"\n",
    "   ],\n",
    "   \"id\": \"3e35ca323c78f8d0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"逻辑与 (and)：两边都为 True 才为 True\",\n",
    "   \"id\": \"c981c05a237f708c\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"logic_and = p and q    # True and False，结果为 False\",\n",
    "   \"id\": \"e300d4e166808b30\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"逻辑或 (or)：任意一边为 True 即为 True\",\n",
    "   \"id\": \"daae3534c2e5b167\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"logic_or = p or q     # True or False，结果为 True\",\n",
    "   \"id\": \"ce982139964cfaed\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"逻辑非 (not)：取反\",\n",
    "   \"id\": \"f09cc4df318a432\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"logic_not = not p     # not True，结果为 False\",\n",
    "   \"id\": \"981e415a1acb5662\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# 4. 赋值运算符\",\n",
    "   \"id\": \"d2e4af624319ecc7\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"i = 5\\n\",\n",
    "    \"j = 10\\n\"\n",
    "   ],\n",
    "   \"id\": \"e26622160c996871\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \" 简单赋值 (=)\",\n",
    "   \"id\": \"f7ef35c338fde2c1\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"i = 7     # i 的值变为 7\",\n",
    "   \"id\": \"32b9f008ba4e9299\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \" 加法赋值 (+=)\",\n",
    "   \"id\": \"7bcd3b07b841fedb\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"i += 3    # i = i + 3， i 的值变为 10\",\n",
    "   \"id\": \"cf87896c9aa96938\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"乘法赋值 (*=)\",\n",
    "   \"id\": \"25846d4f09fd394a\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"j *= 2    # j = j * 2， j 的值变为 20\",\n",
    "   \"id\": \"7360efa776a14c86\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \" 除法赋值 (/=)\",\n",
    "   \"id\": \"a2f8bdd5f02efe67\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"j /= 4    # j = j / 4， j 的值变为 5.0 (注意结果类型变为 float)\",\n",
    "   \"id\": \"fc90a814edc8c7be\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \" 幂赋值 (**=)\",\n",
    "   \"id\": \"16bdc5963eaa45b0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"j = 2\\n\",\n",
    "    \"j **= 3   # j = j ** 3， j 的值变为 8\"\n",
    "   ],\n",
    "   \"id\": \"9a239e7c220cbc8e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# 5.身份运算符\",\n",
    "   \"id\": \"e275af0e8b9c914e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"list_a = [1, 2, 3]\\n\",\n",
    "    \"list_b = [1, 2, 3]\\n\",\n",
    "    \"list_c = list_a  # c 和 a 引用同一个对象\"\n",
    "   ],\n",
    "   \"id\": \"b8885a9bac63c34e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"is：判断是否指向同一个内存地址\",\n",
    "   \"id\": \"544189b288fb22fe\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"id_is = (list_a is list_b)  # 两个列表值相等，但不是同一个对象，结果为 False\\n\",\n",
    "    \"id_is_same = (list_a is list_c) # 引用同一个对象，结果为 True\"\n",
    "   ],\n",
    "   \"id\": \"ca4f58671dffdbc3\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"is not：判断是否不指向同一个内存地址\",\n",
    "   \"id\": \"fae9e08d99a0fa82\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"id_is_not = (list_a is not list_b) # 结果为 True\",\n",
    "   \"id\": \"7fc46f6f0f660ca4\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"注意：对于小整数或短字符串，Python 可能会进行优化，导致 is 结果为 True\",\n",
    "   \"id\": \"f6704d8484f38f30\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"int_1 = 100\\n\",\n",
    "    \"int_2 = 100\\n\",\n",
    "    \"int_is = (int_1 is int_2) # True (Python 优化导致指向一个对象)\"\n",
    "   ],\n",
    "   \"id\": \"3a123b39b54725d6\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# 6. 成员运算符\",\n",
    "   \"id\": \"9a36ddcbd1f8cead\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"my_list = ['apple', 'banana', 'cherry']\\n\",\n",
    "    \"my_string = \\\"Hello World\\\"\"\n",
    "   ],\n",
    "   \"id\": \"51d4d10086556b64\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"in：判断成员是否在序列中\",\n",
    "   \"id\": \"79d45c446dcd32ce\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"member_in_list = ('banana' in my_list)   # 结果为 True\\n\",\n",
    "    \"member_in_string = ('W' in my_string)    # 结果为 True\"\n",
    "   ],\n",
    "   \"id\": \"cc6eab3322c2b6e7\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"not in：判断成员是否不在序列中\",\n",
    "   \"id\": \"e1eed994c7ced45e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
