    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": \"bool_not_equal = (x != y)  # 10 不等于 20，结果为 True\",\n",
