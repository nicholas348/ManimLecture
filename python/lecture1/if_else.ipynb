    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"定义学生成绩变量，赋值为75分\",\n",
    "   \"id\": \"f2829b1aa6943c5c\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"grade = 75\",\n",
    "   \"id\": \"6420b3f6304c605a\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"90分及以上：输出\\\"优秀\\\"\",\n",
    "   \"id\": \"5156bbdd4061efca\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"if grade >= 90:\\n\",\n",
    "    \"    print(\\\"优秀\\\")\"\n",
    "   ],\n",
    "   \"id\": \"af63adc6d2d7429f\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"80-89分：输出\\\"良好\\\"（仅当前面条件不成立时判断）\",\n",
    "   \"id\": \"5c9396612c738d58\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"elif grade >= 80:\\n\",\n",
    "    \"    print(\\\"良好\\\")\"\n",
    "   ],\n",
    "   \"id\": \"c25db6efdd9312b6\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"60-79分：输出\\\"及格\\\"（仅当前面条件都不成立时判断）\",\n",
    "   \"id\": \"9600b6af266bb762\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"elif grade >= 60:\\n\",\n",
    "    \"    print(\\\"及格\\\")\"\n",
    "   ],\n",
    "   \"id\": \"e130514c306a9b23\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"60分以下：输出\\\"不及格\\\"（仅当前面条件都不成立时执行）\\n\",\n",
    "    \"\\n\",\n",
    "    \"在多重判断语句中，当不需要else时，建议在else处输出报错。尽量不要不写else或空着。\"\n",
    "   ],\n",
    "   \"id\": \"cc6ccb0d52cabd56\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"不及格\\\")\"\n",
    "   ],\n",
    "   \"id\": \"6633db04d9ac561a\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"全部代码：\",\n",
    "   \"id\": \"e27f0641cc0ca46f\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"grade = 75\\n\",\n",
    "    \"if grade >= 90:\\n\",\n",
    "    \"    print(\\\"优秀\\\")\\n\",\n",
